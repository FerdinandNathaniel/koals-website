---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="doodle" aria-hidden="true"></div>
  <p>&copy; {year} Koals</p>
  <a href="mailto:hello@koals.eu">hello@koals.eu</a>
</footer>

<style>
  .site-footer {
    position: relative;
    max-width: var(--content-max-width);
    margin-inline: auto;
    margin-top: var(--space-16);
    padding: var(--space-8) var(--space-6) var(--space-12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    border-top: 1px solid var(--color-border);
  }

  .site-footer p {
    margin: 0;
    z-index: 1;
  }

  .site-footer a {
    position: relative;
    z-index: 1;
    color: var(--color-ink-muted);
  }

  .doodle {
    position: absolute;
    bottom: 0;
    right: var(--space-6);
    z-index: 0;
    width: 150px;
    aspect-ratio: 686 / 518;
    background-color: var(--color-ink-muted);
    opacity: 0.16;
    pointer-events: none;
    -webkit-mask-image: url('/doodle-wave.png');
    mask-image: url('/doodle-wave.png');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: bottom right;
    mask-position: bottom right;
  }
</style>
