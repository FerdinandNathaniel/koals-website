---
interface Props {
  title: string;
  category: string;
  image: string;
  alt: string;
  slug?: string;
  framed?: boolean;
}

const { title, category, image, alt, slug, framed = false } = Astro.props;
const Wrapper = slug ? 'a' : 'div';
const wrapperProps = slug ? { href: `/work/${slug}/` } : {};
---

<figure class="card">
  <Wrapper class="card-link" {...wrapperProps}>
    <div class:list={['frame', { framed }]}>
      <div class="image-wrap">
        <img src={image} alt={alt} loading="lazy" />
        {framed && <div class="tint" aria-hidden="true"></div>}
      </div>
    </div>
  </Wrapper>
  <figcaption>
    <span class="title">{title}</span>
    <span class="category">{category}</span>
  </figcaption>
</figure>

<style>
  .card {
    margin: 0 0 var(--space-8);
    break-inside: avoid;
  }

  .card-link {
    display: block;
  }

  .frame img {
    width: 100%;
    border-radius: var(--radius-soft);
    transition: opacity var(--duration-soft) var(--ease-soft);
  }

  .frame.framed {
    box-shadow: var(--shadow-paper);
    border-radius: var(--radius-soft);
  }

  .image-wrap {
    position: relative;
    border-radius: var(--radius-soft);
    overflow: hidden;
  }

  .tint {
    position: absolute;
    inset: 0;
    background: var(--color-image-tint);
    opacity: 0.07;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  figcaption {
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .title {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .category {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
